/* pages/permission-manage/index.wxss */
.permission-container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 圆角 cell 样式 */
.cell {
  width: 100%;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

.cell-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.cell-arrow {
  font-size: 32rpx;
  color: #999;
}

