/* pages/reminder/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
}

.header-action {
  width: 48rpx;
  height: 48rpx;
  margin-left: 24rpx;
}

.content {
  padding: 40rpx;
}

.section {
  margin-bottom: 40rpx;
}

.completed-section {
  opacity: 0.6;
}

.reminder-item {
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #ff9ecf 0%, #ff84c4 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 207, 0.3);
}

.reminder-item.item-1 {
  background: linear-gradient(135deg, #ff9ecf 0%, #ff84c4 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 207, 0.3);
}

.reminder-item.item-2 {
  background: linear-gradient(135deg, #a8e6cf 0%, #7dd3b0 100%);
  box-shadow: 0 4rpx 12rpx rgba(168, 230, 207, 0.3);
}

.reminder-item.item-3 {
  background: linear-gradient(135deg, #ffd93d 0%, #ffc93c 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 217, 61, 0.3);
}

.reminder-item.item-4 {
  background: linear-gradient(135deg, #b4e7f7 0%, #9dd5eb 100%);
  box-shadow: 0 4rpx 12rpx rgba(180, 231, 247, 0.3);
}

.reminder-item.completed {
  background: #f5f5f5;
  box-shadow: none;
}

.reminder-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  margin-right: 24rpx;
  position: relative;
}

.reminder-circle.checked {
  background-color: #fff;
  border-color: #ddd;
}

.reminder-circle.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #07c160;
  font-size: 24rpx;
  font-weight: bold;
}

.reminder-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  flex: 1;
}

.reminder-item.completed .reminder-title {
  color: #999;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

