<!--pages/todo/index.wxml - 创建提醒事项页面-->
<view class="container">
  <view class="header">
    <text class="header-title">创建提醒事项</text>
    <text class="header-subtitle">设置您的待办事项和时间提醒</text>
  </view>

  <view class="form">
    <!-- 标题输入 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">标题</text>
        <text class="label-required">*</text>
      </view>
      <input 
        class="input" 
        placeholder="请输入提醒事项标题" 
        maxlength="50"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>

    <!-- 事项描述 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">事项描述</text>
      </view>
      <textarea 
        class="textarea" 
        placeholder="请输入事项描述（选填）" 
        maxlength="200"
        value="{{description}}"
        bindinput="onDescriptionInput"
      />
    </view>

    <!-- 提醒日期 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">提醒日期</text>
        <text class="label-required">*</text>
      </view>
      <picker 
        mode="date"
        value="{{remindDate}}"
        bindchange="onDateChange"
      >
        <view class="picker-view">
          <text wx:if="{{remindDate}}" class="picker-text">{{remindDate}}</text>
          <text wx:else class="picker-placeholder">请选择日期</text>
          <image class="picker-arrow" src="../../images/arrow.svg" />
        </view>
      </picker>
    </view>

    <!-- 提醒时间 -->
    <view class="form-item">
      <view class="label">
        <text class="label-text">提醒时间</text>
      </view>
      <picker 
        mode="time"
        value="{{remindTime}}"
        bindchange="onTimeChange"
      >
        <view class="picker-view">
          <text wx:if="{{remindTime}}" class="picker-text">{{remindTime}}</text>
          <text wx:else class="picker-placeholder">请选择时间</text>
          <image class="picker-arrow" src="../../images/arrow.svg" />
        </view>
      </picker>
    </view>

    <!-- 创建按钮 -->
    <button 
      class="create-btn {{submitting ? 'disabled' : ''}}" 
      bindtap="onCreateTodo"
      disabled="{{submitting}}"
    >
      {{submitting ? '创建中...' : '创建提醒事项'}}
    </button>
  </view>
</view>

