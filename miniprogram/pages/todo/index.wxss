/* pages/todo/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 40rpx 40rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.header-subtitle {
  display: block;
  font-size: 28rpx;
  color: #999;
}

.form {
  padding: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.label-required {
  color: #ff4d4f;
  margin-left: 4rpx;
  font-size: 32rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background-color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background-color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.picker-view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #fff;
  border-radius: 8rpx;
}

.picker-text {
  font-size: 32rpx;
  color: #333;
}

.picker-placeholder {
  font-size: 32rpx;
  color: #999;
}

.picker-arrow {
  width: 24rpx;
  height: 24rpx;
  transform: rotate(90deg);
}

.create-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a84f 100%);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  margin-top: 60rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.create-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.create-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

.create-btn.disabled:active {
  transform: none;
}

