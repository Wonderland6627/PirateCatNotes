/* pages/todo-edit/index.wxss */
/* 
 * 注意：颜色配置定义在 config/constants.js 的 TODO_COLORS 中
 * 如需修改颜色，请同时更新 constants.js 和本文件中的对应样式
 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.content {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  flex: 1;
}

.cell {
  width: 100%;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
}

.cell-input {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  line-height: 44rpx;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

.title-input {
  font-size: 32rpx;
  font-weight: 600;
}

.description-input {
  font-size: 32rpx;
  font-weight: 400;
}

.cell-input::placeholder {
  color: #999;
}

.cell-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

.cell-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.cell-value {
  font-size: 32rpx;
  color: #666;
  flex: 1;
  text-align: right;
}

.cell-value.placeholder {
  color: #999;
}

.cell-color {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.color-options {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 32rpx;
  margin-top: 24rpx;
}

.color-option {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  cursor: pointer;
}

.color-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid #e0e0e0;
  box-sizing: border-box;
  transition: all 0.2s;
}

/* 注意：颜色圆圈样式现在通过内联样式动态设置，配置在 constants.js 的 TODO_COLORS 中 */

.color-option.selected .color-circle {
  border-color: #333;
  border-width: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.color-check {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
  pointer-events: none;
}

.footer {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.save-btn {
  width: 100%;
  padding: 28rpx 0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

/* 注意：完成按钮颜色样式现在通过内联样式动态设置，配置在 constants.js 的 TODO_COLORS 中 */

.save-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

