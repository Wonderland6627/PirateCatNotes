/* pages/todo-edit/index.wxss */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.content {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  flex: 1;
}

.cell {
  width: 100%;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.cell-input {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.5;
  min-height: 60rpx;
  box-sizing: border-box;
}

.title-input {
  font-size: 36rpx;
  font-weight: 600;
}

.description-input {
  font-size: 32rpx;
  font-weight: 400;
}

.cell-input::placeholder {
  color: #999;
}

.cell-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

.cell-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.cell-value {
  font-size: 32rpx;
  color: #666;
  flex: 1;
  text-align: right;
}

.cell-value.placeholder {
  color: #999;
}

.footer {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.save-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(135deg, #ff9ecf 0%, #ff84c4 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 207, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.save-btn-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

