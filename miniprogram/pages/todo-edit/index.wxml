<!--pages/todo-edit/index.wxml - 编辑待办页面-->
<view class="container">
  <view class="content">
    <!-- 标题输入 -->
    <view class="cell">
      <textarea 
        class="cell-input title-input"
        placeholder="输入标题"
        value="{{content}}"
        bindinput="onContentInput"
        auto-height="{{true}}"
        maxlength="{{500}}"
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>

    <!-- 备注输入 -->
    <view class="cell">
      <textarea 
        class="cell-input description-input"
        placeholder="输入备注"
        value="{{description}}"
        bindinput="onDescriptionInput"
        auto-height="{{true}}"
        maxlength="{{1000}}"
        show-confirm-bar="{{false}}"
      ></textarea>
    </view>

    <!-- 提醒日期和时间 -->
    <view class="cell cell-picker">
      <view class="cell-label">提醒日期</view>
      <picker 
        mode="date" 
        value="{{remindDate}}"
        start="{{startDate}}"
        bindchange="onRemindDateChange"
      >
        <view class="cell-value {{!remindDate ? 'placeholder' : ''}}">{{remindDate || '选择日期'}}</view>
      </picker>
    </view>

    <view class="cell cell-picker">
      <view class="cell-label">提醒时间</view>
      <picker 
        mode="time" 
        value="{{remindTime}}"
        start="{{startTime}}"
        bindchange="onRemindTimeChange"
      >
        <view class="cell-value {{!remindTime ? 'placeholder' : ''}}">{{remindTime || '选择时间'}}</view>
      </picker>
    </view>

    <!-- 颜色选择 -->
    <view class="cell cell-color">
      <view class="cell-label">颜色</view>
      <view class="color-options">
        <view 
          wx:for="{{colorOptions}}" 
          wx:key="value"
          class="color-option {{selectedColor === item.value ? 'selected' : ''}}"
          data-color="{{item.value}}"
          bindtap="onColorSelect"
        >
          <view class="color-circle" style="background: {{item.gradient}}"></view>
          <view class="color-check" wx:if="{{selectedColor === item.value}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成按钮 -->
  <view class="footer">
    <view class="save-btn" style="{{saveBtnStyle}}" bindtap="onSave">
      <text class="save-btn-text">完成</text>
    </view>
  </view>
</view>

