/* pages/temp/index.wxss */
.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

.test-btn {
  background-color: #07c160;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
  margin-bottom: 20rpx;
}

.subscribe-btn {
  background-color: #ff6b35;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
  margin-bottom: 20rpx;
}

.send-btn {
  background-color: #1890ff;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
  margin-bottom: 20rpx;
}

.check-btn {
  background-color: #722ed1;
  color: white;
  border-radius: 8rpx;
  font-size: 32rpx;
  padding: 20rpx 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(114, 46, 209, 0.3);
  margin-bottom: 20rpx;
}

.test-btn:active, .subscribe-btn:active, .send-btn:active, .check-btn:active {
  transform: translateY(2rpx);
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
  text-align: center;
  line-height: 1.5;
}