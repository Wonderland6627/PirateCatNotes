/* pages/edit-profile/index.wxss */
.edit-profile-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx;
}

.profile-header {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 40rpx 0;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #999;
  display: block;
}

.content-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.section-label {
  font-size: 32rpx;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 40rpx;
}

.avatar-button {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  border: none;
  overflow: visible;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-button::after {
  border: none;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 4rpx solid #07c160;
}

.avatar-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.nickname-section {
  display: flex;
  flex-direction: column;
}

.nickname-input {
  font-size: 32rpx;
  color: #333;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  background: #fff;
}

.nickname-input:focus {
  border-color: #07c160;
}

.save-section {
  margin-top: 40rpx;
}

.save-btn {
  width: 100%;
  background-color: #07c160;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 28rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.save-btn:active {
  background-color: #06ad56;
}
