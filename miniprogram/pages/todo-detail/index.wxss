/* pages/todo-detail/index.wxss */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 32rpx;
  color: #999;
}

.detail-content {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
}

.detail-item {
  width: 100%;
  margin-bottom: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.title-item {
  margin-top: 0;
  padding: 40rpx 32rpx;
}

.title-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  word-break: break-word;
}

.detail-label {
  margin-bottom: 12rpx;
}

.label-text {
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.detail-value {
  margin-top: 4rpx;
}

.value-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-word;
}

.status-text {
  font-weight: 500;
}

.status-pending {
  color: #ff9800;
}

.status-reminded {
  color: #2196f3;
}

.status-completed {
  color: #4caf50;
}

