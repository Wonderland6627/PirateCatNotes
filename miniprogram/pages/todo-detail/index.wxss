/* pages/todo-detail/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 32rpx;
  color: #999;
}

.header {
  padding: 40rpx 40rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.detail-content {
  padding: 40rpx;
}

.detail-item {
  margin-bottom: 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
}

.detail-label {
  margin-bottom: 16rpx;
}

.label-text {
  font-size: 28rpx;
  color: #999;
}

.detail-value {
  margin-top: 8rpx;
}

.value-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-word;
}

.status-text {
  font-weight: 500;
}

.status-pending {
  color: #ff9800;
}

.status-reminded {
  color: #2196f3;
}

.status-completed {
  color: #4caf50;
}

