<!--pages/todo-detail/index.wxml - 待办事项详情页面-->
<view class="container">
  <!-- 加载中状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 详情内容 -->
  <view class="detail-content" wx:else>
      <!-- 标题 - 突出显示 -->
      <view class="detail-item title-item">
        <view class="title-text">{{content}}</view>
      </view>

      <!-- 事项描述 -->
      <view class="detail-item" wx:if="{{description}}">
        <view class="detail-label">
          <text class="label-text">事项描述</text>
        </view>
        <view class="detail-value">
          <text class="value-text">{{description}}</text>
        </view>
      </view>

      <!-- 提醒时间 -->
      <view class="detail-item" wx:if="{{remindAt}}">
        <view class="detail-label">
          <text class="label-text">提醒时间</text>
        </view>
        <view class="detail-value">
          <text class="value-text">{{remindAt}}</text>
        </view>
      </view>

      <!-- 状态 -->
      <view class="detail-item">
        <view class="detail-label">
          <text class="label-text">状态</text>
        </view>
        <view class="detail-value">
          <text class="value-text status-text status-{{status}}">
            <text wx:if="{{status === 'pending'}}">待提醒</text>
            <text wx:elif="{{status === 'reminded'}}">已提醒</text>
            <text wx:elif="{{status === 'completed'}}">已完成</text>
            <text wx:else>{{status}}</text>
          </text>
        </view>
      </view>

      <!-- 创建时间 -->
      <view class="detail-item" wx:if="{{createdAt}}">
        <view class="detail-label">
          <text class="label-text">创建时间</text>
        </view>
        <view class="detail-value">
          <text class="value-text">{{createdAt}}</text>
        </view>
      </view>

      <!-- 更新时间 -->
      <view class="detail-item" wx:if="{{updatedAt}}">
        <view class="detail-label">
          <text class="label-text">更新时间</text>
        </view>
        <view class="detail-value">
          <text class="value-text">{{updatedAt}}</text>
        </view>
      </view>
    </view>
</view>

