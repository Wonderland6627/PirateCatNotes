/* pages/todo-list/index.wxss */
/* 
 * 注意：颜色配置定义在 config/constants.js 的 TODO_COLORS 中
 * 如需修改颜色，请同时更新 constants.js 和本文件中的对应样式
 */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  align-items: stretch;
}

.header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
}

.header-action {
  width: 48rpx;
  height: 48rpx;
  margin-left: 24rpx;
}

.header-create-btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: 24rpx;
  background: linear-gradient(135deg, #ff9ecf 0%, #ff84c4 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 207, 0.3);
}

.create-btn-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1;
}

.content {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
}

.section {
  width: 100%;
  margin-bottom: 40rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  width: 100%;
  height: 120rpx;
  padding: 0 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 注意：颜色样式现在通过内联样式动态设置，配置在 constants.js 的 TODO_COLORS 中 */

.todo-item.gray {
  background: #e8e8e8;
  box-shadow: none;
  opacity: 0.7;
}

.todo-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  margin-right: 24rpx;
  position: relative;
  flex-shrink: 0;
  cursor: pointer;
}

.todo-circle.checked {
  background-color: #fff;
  border-color: #ddd;
}

.todo-circle.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #07c160;
  font-size: 24rpx;
  font-weight: bold;
}

.todo-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-item.gray .todo-title {
  color: #999;
}

.todo-item.gray .todo-circle {
  border-color: #ccc;
}

/* 分割线样式 */
.divider {
  width: 100%;
  height: 2rpx;
  background-color: #ddd;
  margin: 32rpx 0;
  border-radius: 1rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 创建输入框样式 */
.create-container {
  width: 100%;
  margin-bottom: 100rpx;
  position: relative;
}

.create-input-wrapper {
  width: 100%;
  height: 360rpx;
  padding: 32rpx;
  background: transparent;
  border: 3rpx solid #ff9ecf;
  border-radius: 16rpx;
  box-sizing: border-box;
  position: relative;
}

.create-input {
  width: 100%;
  height: 100%;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  box-sizing: border-box;
  line-height: 1.5;
  padding-left: 90rpx;
}

.create-input::placeholder {
  color: #999;
}

.create-todo-icon {
  position: absolute;
  left: -48rpx;
  bottom: -15rpx;
  width: 200rpx;
  height: 200rpx;
  z-index: 1;
}

.create-buttons {
  position: absolute;
  right: 0;
  bottom: -80rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.create-cancel-btn {
  padding: 12rpx 0;
  cursor: pointer;
}

.cancel-btn-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

/* 注意：创建按钮颜色样式现在通过内联样式动态设置，配置在 constants.js 的 TODO_COLORS 中 */
.create-complete-btn {
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  cursor: pointer;
}

.complete-btn-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

