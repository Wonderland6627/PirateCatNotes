/* pages/todo-list/index.wxss */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  align-items: stretch;
}

.header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
}

.header-action {
  width: 48rpx;
  height: 48rpx;
  margin-left: 24rpx;
}

.content {
  width: 100%;
  padding: 40rpx;
  box-sizing: border-box;
}

.section {
  width: 100%;
  margin-bottom: 40rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  width: 100%;
  height: 120rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #ff9ecf 0%, #ff84c4 100%);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 207, 0.3);
  box-sizing: border-box;
}

.todo-item.item-1 {
  background: linear-gradient(135deg, #ff9ecf 0%, #ff84c4 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 158, 207, 0.3);
}

.todo-item.item-2 {
  background: linear-gradient(135deg, #a8e6cf 0%, #7dd3b0 100%);
  box-shadow: 0 4rpx 12rpx rgba(168, 230, 207, 0.3);
}

.todo-item.item-3 {
  background: linear-gradient(135deg, #ffd93d 0%, #ffc93c 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 217, 61, 0.3);
}

.todo-item.item-4 {
  background: linear-gradient(135deg, #b4e7f7 0%, #9dd5eb 100%);
  box-shadow: 0 4rpx 12rpx rgba(180, 231, 247, 0.3);
}

.todo-item.gray {
  background: #e8e8e8;
  box-shadow: none;
  opacity: 0.7;
}

.todo-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  margin-right: 24rpx;
  position: relative;
  flex-shrink: 0;
  cursor: pointer;
}

.todo-circle.checked {
  background-color: #fff;
  border-color: #ddd;
}

.todo-circle.checked::after {
  content: '✓';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #07c160;
  font-size: 24rpx;
  font-weight: bold;
}

.todo-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  flex: 1;
}

.todo-item.gray .todo-title {
  color: #999;
}

.todo-item.gray .todo-circle {
  border-color: #ccc;
}

/* 分割线样式 */
.divider {
  width: 100%;
  height: 2rpx;
  background-color: #ddd;
  margin: 32rpx 0;
  border-radius: 1rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

