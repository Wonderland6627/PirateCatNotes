<!--pages/profile/index.wxml-->
<view class="profile-container">
  <!-- 背景图 -->
  <view class="background-image">
    <image class="bg-img" mode="aspectFill" src="https://images.unsplash.com/photo-1558478551-891f59c0a40e?w=800&h=400&fit=crop"></image>
    <view class="bg-overlay"></view>
  </view>

  <!-- 用户信息区域 -->
  <view class="user-info-section">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    <text class="nickname">{{userInfo.nickName}}</text>
    <text class="welcome">欢迎来到海盗猫笔记</text>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <!-- 编辑个人信息 -->
    <view class="cell" bindtap="onNavigateToEditProfile">
      <view class="cell-left">
        <image class="cell-icon" src="/images/icons/copy.png"></image>
        <text class="cell-label">编辑个人信息</text>
      </view>
      <text class="cell-arrow">></text>
    </view>

    <!-- 设置 -->
    <view class="cell" bindtap="onNavigateToSettings">
      <view class="cell-left">
        <image class="cell-icon" src="/images/icons/setting.svg"></image>
        <text class="cell-label">设置</text>
      </view>
      <text class="cell-arrow">></text>
    </view>

    <!-- 关于我们 -->
    <view class="cell" bindtap="onAboutUs">
      <view class="cell-left">
        <image class="cell-icon" src="/images/icons/question.svg"></image>
        <text class="cell-label">关于我们</text>
      </view>
      <text class="cell-arrow">></text>
    </view>

    <!-- 客服 -->
    <view class="cell">
      <view class="cell-left">
        <image class="cell-icon" src="/images/icons/customer-service.svg"></image>
        <text class="cell-label">客服中心</text>
      </view>
      <text class="cell-arrow">></text>
    </view>
  </view>

</view>
